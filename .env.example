# Copy to app/.env and fill with values from `terraform output`.
# Or run `make env` to generate it automatically.

AWS_REGION=us-west-2

# From: terraform output guardrail_id / guardrail_version
GUARDRAIL_ID=your-guardrail-id
GUARDRAIL_VERSION=1

# From: terraform output memory_id
MEMORY_ID=your-memory-id

# Model used by the agents (Bedrock inference profile or model id)
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# SSN policy — flip and test, no redeploy.
# BLOCK (default) refuses to store the turn; ANONYMIZE masks to {TYPE}.
SSN_ACTION=BLOCK
