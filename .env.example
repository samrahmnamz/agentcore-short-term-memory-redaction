# Copy to app/.env and fill with values from `terraform output`.
# Or run `make env` to generate it automatically.

AWS_REGION=us-west-2
MEMORY_ID=your-memory-id

# SSN is BLOCKED (default). From: terraform output block_guardrail_id
GUARDRAIL_ID=your-block-guardrail-id
GUARDRAIL_VERSION=1

# SSN is MASKED. Used by `make strands-mask` / `make langgraph-mask`.
# From: terraform output mask_guardrail_id
GUARDRAIL_ID_MASK=your-mask-guardrail-id
GUARDRAIL_VERSION_MASK=1

# Model used by the agents (Bedrock inference profile or model id)
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
